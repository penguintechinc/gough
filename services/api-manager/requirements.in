# Distributed key-value store (Phase 2 quorum check)
# etcd3==0.12.0 replaced by aetcd: etcd3's own bundled *_pb2.py stubs use the
# legacy pre-protoc-3.19 _descriptor.FileDescriptor() API, which raises
# "TypeError: Descriptors cannot be created directly" under any protobuf
# runtime built with the (default) upb/C++ backend -- protobuf>=4. etcd3 has
# had no release since 0.12.0 (2020), so there is no fixed version to pin to.
# aetcd is the actively maintained, async-native successor (protobuf<8,>4,
# grpcio<2,>1.66.0) and is a closer fit for this async/Quart codebase anyway
# (no more asyncio.to_thread() wrapping of a sync client). regression: gh-22
aetcd==1.0.0  # etcd v3 client; Phase 2 primary HA cluster state check

# gRPC runtime (server revived gh-22; buf-generated stubs are gencode 5.28.3,
# which requires protobuf>=5.27 at runtime -- see protobuf pin below)
grpcio==1.70.0

# Event stream / messaging
nats-py==2.9.0  # NATS JetStream client; Sprint 4 event stream
redis==5.2.1  # redis.asyncio client (session/cache store)
cryptography==50.0.2

