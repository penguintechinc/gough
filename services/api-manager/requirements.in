google-cloud-compute==1.19.2
# app/clouds/azure.py imports from all four of these. Pinning azure-mgmt-compute
# alone left AZURE_AVAILABLE=False at runtime (azure.identity / azure.mgmt.network
# / azure.mgmt.resource are NOT transitive deps of azure-mgmt-compute), so every
# AzureCloud() raised "Azure SDK not available" while the provider stayed
# registered in CLOUD_REGISTRY -- failing only once an operator added an Azure
# provider, never at import time.
azure-mgmt-compute==37.1.0
azure-identity==1.25.3
azure-mgmt-network==32.0.0
azure-mgmt-resource==26.0.0

