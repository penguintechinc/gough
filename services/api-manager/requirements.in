# protobuf runtime 5.29.6 (CVE-2025-4565 / CVE-2026-0994 fixes). Runtime >= the
# gencode version is compatible: buf-generated *_pb2.py in app/grpc/ declare
# "Protobuf Python Version: 5.28.3" (proto/buf.gen.yaml -> v28.3); regenerate stubs
# (`make proto`) when the plugin pin moves.
protobuf==5.29.6

